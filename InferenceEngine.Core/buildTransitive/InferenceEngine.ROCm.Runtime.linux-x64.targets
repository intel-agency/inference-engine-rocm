<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    This targets file ensures InferenceEngine.ROCm.Runtime.linux-x64's native assets
    take precedence over ALL conflicting native assets from transitive dependencies
    (specifically Microsoft.ML.OnnxRuntime's CPU-only native libraries including
    libonnxruntime.so, libonnxruntime_providers_shared.so, and any other ORT natives).

    This prevents nondeterministic runtime loading of the wrong native library.

    Note: This package uses AMD's MIGraphX Execution Provider (successor to ROCm EP).

    Any project that references this NuGet package will automatically get:
    - ROCm-accelerated libonnxruntime.so replacing the CPU-only version
    - libonnxruntime_providers_migraphx.so for AMD GPU execution via MIGraphX
  -->

  <Target Name="EnsureRocmNativeAssetPrecedence"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="CopyFilesToOutputDirectory">

    <ItemGroup>
      <!-- Identify this package's linux-x64 native assets -->
      <_RocmNativeAssets Include="@(RuntimeCopyLocalItems)"
                         Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'InferenceEngine.ROCm.Runtime.linux-x64'
                                    AND '%(RuntimeCopyLocalItems.AssetType)' == 'native'
                                    AND '%(RuntimeCopyLocalItems.RuntimeIdentifier)' == 'linux-x64'" />
    </ItemGroup>

    <PropertyGroup>
      <!-- Only remove conflicting ORT natives when this package actually ships its own linux-x64 assets.
           Without this guard, a local dotnet pack (without the ROCm .so files) would strip the CPU-only
           libonnxruntime.so leaving consumers with no native library at all. -->
      <_HasRocmLinuxX64NativeAssets Condition="'@(_RocmNativeAssets)' != ''">true</_HasRocmLinuxX64NativeAssets>
      <_HasRocmLinuxX64NativeAssets Condition="'@(_RocmNativeAssets)' == ''">false</_HasRocmLinuxX64NativeAssets>
    </PropertyGroup>

    <ItemGroup>
      <!-- Remove conflicting ORT native assets from other packages only when this package provides replacements -->
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
                             Condition="'$(_HasRocmLinuxX64NativeAssets)' == 'true'
                                        AND $([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('Microsoft.ML.OnnxRuntime'))
                                        AND '%(RuntimeCopyLocalItems.NuGetPackageId)' != 'InferenceEngine.ROCm.Runtime.linux-x64'
                                        AND '%(RuntimeCopyLocalItems.AssetType)' == 'native'
                                        AND '%(RuntimeCopyLocalItems.RuntimeIdentifier)' == 'linux-x64'" />

      <!-- Remove any existing entries to prevent duplicates before re-adding -->
      <RuntimeCopyLocalItems Remove="@(_RocmNativeAssets)"
                             Condition="'$(_HasRocmLinuxX64NativeAssets)' == 'true'" />

      <!-- Re-add this package's native assets to ensure they're copied with correct precedence -->
      <RuntimeCopyLocalItems Include="@(_RocmNativeAssets)"
                             Condition="'$(_HasRocmLinuxX64NativeAssets)' == 'true'" />
    </ItemGroup>

  </Target>

  <!--
    Consumer-side load fix (regression found testing 1.24.1.41):
    Microsoft.ML.OnnxRuntime's managed bindings pinvoke "onnxruntime.dll" on ALL
    platforms. On Linux, .NET's probe derives only onnxruntime.dll[.so] /
    libonnxruntime.dll[.so] candidate names - never libonnxruntime.so - so a
    vanilla consumer fails with DllNotFoundException unless a file NAMED
    onnxruntime.dll sits in the application directory (this is also why the CI
    validate job injects that alias).

    We copy our three shipped libraries from the restored package directory
    (via the Pkg<PackageId> property NuGet generates) straight to the output
    root, plus the onnxruntime.dll pinvoke alias. Deterministic on every SDK:
    RuntimeCopyLocalItems surgery (target above) is kept for SDKs that
    populate it, but .NET 10 consumer builds leave it empty.
  -->
  <Target Name="EnsureRocmOrtDllImportAlias"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">

    <PropertyGroup>
      <!-- libonnxruntime_providers_migraphx.so is unique to THIS package
           (Microsoft.ML.OnnxRuntime never ships it), so its presence in the
           output tree fingerprints our assets - and doubles as the
           empty-package guard: a pack without .so files leaves this blank
           and the whole target no-ops. Handles both layouts: RID-specific
           builds flatten natives to the output root; portable builds keep
           them under runtimes/linux-x64/native/. -->
      <_RocmNativeDir Condition="Exists('$(OutDir)runtimes/linux-x64/native/libonnxruntime_providers_migraphx.so')">$(OutDir)runtimes/linux-x64/native/</_RocmNativeDir>
      <_RocmNativeDir Condition="'$(_RocmNativeDir)' == '' And Exists('$(OutDir)libonnxruntime_providers_migraphx.so')">$(OutDir)</_RocmNativeDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(_RocmNativeDir)' != ''">
      <_RocmShippedLibs Include="$(_RocmNativeDir)libonnxruntime.so" />
      <_RocmShippedLibs Include="$(_RocmNativeDir)libonnxruntime_providers_shared.so" />
      <_RocmShippedLibs Include="$(_RocmNativeDir)libonnxruntime_providers_migraphx.so" />
    </ItemGroup>

    <!-- Flatten to the application directory (ORT discovers providers next to the core lib) -->
    <Copy SourceFiles="@(_RocmShippedLibs)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'$(_RocmNativeDir)' != '' And '$(_RocmNativeDir)' != '$(OutDir)'" />

    <!-- The pinvoke-name alias: onnxruntime.dll -> our ROCm/MIGraphX ELF -->
    <Copy SourceFiles="$(_RocmNativeDir)libonnxruntime.so"
          DestinationFiles="$(OutDir)onnxruntime.dll"
          SkipUnchangedFiles="true"
          Condition="'$(_RocmNativeDir)' != ''" />

  </Target>

</Project>
